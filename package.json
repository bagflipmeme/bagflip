{
  "name": "bagflip",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "BAGFLIP — community-controlled meme treasury (Telegram + NEAR governance, Solana AUTO HUNT trading)",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
