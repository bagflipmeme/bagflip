    "seed:dev": "node scripts/dev-seed.ts",
    "replay": "node scripts/replay.ts",
    "verify:live": "node scripts/verify-live.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@near-js/crypto": "2.5.1",
