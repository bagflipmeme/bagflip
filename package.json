    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "grammy": "1.46.0",
    "pg": "8.23.1",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
