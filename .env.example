# ─────────────────────────────────────────────────────────────────────────────
# BAGFLIP configuration. Copy to .env and fill in. Never commit real secrets.
# Unsafe combinations are rejected at boot (see src/shared/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# development = simulated chain, market, bridge and fills (no network, no funds)
# paper       = real NEAR reads + real market data, virtual capital, no fund movement
# live        = real treasury + trading wallet (still needs the LIVE_* flags below)
BAGFLIP_ENV=development
NODE_ENV=production
# all | bot | api | worker   (run exactly ONE worker)
ROLE=all
LOG_LEVEL=info
PORT=8080
# Public HTTPS URL of this service (Telegram Mini App + webhook). Mini Apps require https.
PUBLIC_URL=https://your-app.up.railway.app
# Bearer token for /admin/* HTTP endpoints. Generate: openssl rand -hex 32
ADMIN_API_TOKEN=

# PostgreSQL (required in live). Empty = embedded PGlite at PGLITE_DATA_DIR (dev/paper only).
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Group chat id (e.g. -1001234567890). The bot needs "pin messages" rights there.
TELEGRAM_GROUP_ID=
# Comma-separated numeric Telegram user ids allowed to run admin commands.
TELEGRAM_ADMIN_IDS=
# If set, the bot uses a webhook at PUBLIC_URL/telegram/webhook authenticated by this secret;
# otherwise long polling. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── NEAR ──
NEAR_NETWORK=mainnet
# Use a keyed RPC in production: distribution snapshots read every holder's balance at one block,
# and the free tier rate-limits per IP (verified: HTTP 429 after repeated full scans).
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# Optional archival RPC (only needed to snapshot a block >~2 days old after long downtime).
NEAR_ARCHIVAL_RPC_URL=
FASTNEAR_API_URL=https://api.fastnear.com
FASTNEAR_TX_API_URL=https://tx.main.fastnear.com
# BAGFLIP token on the justhoot launchpad (check ft_metadata if you ever point this at another token).
MEME_TOKEN_CONTRACT_ID=bagflip.v2-launchpad.justhoot.near
MEME_TOKEN_SYMBOL=BAGFLIP
MEME_TOKEN_DECIMALS=18
# Creator wallet: the ONLY default allowed deposit sender. Never read for funds, never signed for.
CREATOR_WALLET_ADDRESS=
# The BAGFLIP vault: contracts/vault deployed to this account and then LOCKED (all keys deleted).
# Nobody holds a key to it. See docs/VAULT.md. Must not be the creator wallet.
TREASURY_NEAR_ADDRESS=bagflip.near
# Bot account that calls the vault. Give it a FUNCTION-CALL key limited to the vault's operator
# methods (scripts/vault-plan.ts prints the command). Only used when LIVE_TRANSFERS_ENABLED=true.
OPERATOR_ACCOUNT_ID=bagflip-bot.near
OPERATOR_PRIVATE_KEY=
# Vault init parameters (authoritative on chain after deploy; also used by the in-process SimVault).
VAULT_MODE_DELAY_HOURS=12
VAULT_DISTRIBUTION_DELAY_HOURS=24
VAULT_ADMIN_DELAY_HOURS=48
VAULT_DAILY_HUNT_CAP_NEAR=50
# Holder Council: the top N token holders guard the vault. Seats are contested ON CHAIN (the vault reads
# ft_balance_of; the larger holder wins). EXCLUDED_HOLDER_ACCOUNTS can never sit.
VAULT_COUNCIL_SEATS=10
# Minimum BAGFLIP (whole tokens) to hold a seat. Set after launch relative to supply.
VAULT_MIN_SEAT_BALANCE=100000
# A new seat can vote only after this long (no buy-and-vote).
VAULT_SEAT_MIN_AGE_HOURS=24
# Seats needed to veto a payout list / AUTO HUNT activation or to pause.
VAULT_VETO_THRESHOLD=3
# Seats needed (plus VAULT_ADMIN_DELAY_HOURS) to change operator/cap/exclusions, revoke a list, unpause.
VAULT_ADMIN_THRESHOLD=6
# Extra accounts whose transfers into the treasury count as deposits (comma-separated).
DEPOSIT_ALLOWED_SENDERS=
# Accounts excluded from voting, quorum supply and distributions: pools, bridges, contracts.
# After launch, list the pool/bridge accounts holding BAGFLIP (FastNEAR /v1/ft/<token>/top). For BAGFLIP the Rhea
# DCL pool dclv2.ref-labs.near holds most of the supply. Treasury + token always excluded.
EXCLUDED_HOLDER_ACCOUNTS=dclv2.ref-labs.near,intents.near
# App identifier signed into every NEP-413 challenge (binds signatures to BAGFLIP).
NEP413_RECIPIENT=bagflip-treasury-bot
AUTH_CHALLENGE_TTL_MINUTES=10
# NEAR kept back for gas/storage; never traded or distributed.
NEAR_FEE_RESERVE=0.5

# ── Solana ──
# A paid RPC (Helius, Triton, QuickNode...) is strongly recommended for live trading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TRADING_WALLET_ADDRESS=
# Base58 secret key of the dedicated trading wallet (live + LIVE_TRADING_ENABLED only).
SOLANA_TRADING_PRIVATE_KEY=
SOL_FEE_RESERVE=0.01

# ── NEAR Intents 1Click ──
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Partner JWT from https://partners.near-intents.org (without it 1Click adds 0.25% per swap).
ONECLICK_API_KEY=
BRIDGE_SLIPPAGE_BPS=100
BRIDGE_DEADLINE_MINUTES=60

# ── Execution venues + market data ──
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
# https://developers.jup.ag/portal — keyless is limited to 0.5 req/s.
JUPITER_API_KEY=
PUMPPORTAL_BASE_URL=https://pumpportal.fun
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_DISCOVERY=true
DEXSCREENER_BASE_URL=https://api.dexscreener.com
# auto = Jupiter first, PumpPortal local-tx fallback
EXECUTION_VENUE=auto

# ── Governance schedule ──
TIMEZONE=Asia/Kuala_Lumpur
DAILY_DECISION_HOUR=0
DAILY_DECISION_MINUTE=0
# Quorum = % of eligible circulating supply (total minus excluded accounts) that must vote.
VOTING_INITIAL_QUORUM_PERCENT=5
VOTING_MIN_QUORUM_PERCENT=3
VOTING_MIN_DISTINCT_WALLETS=3
# Dust below this token balance does not vote or receive distributions.
MIN_ELIGIBLE_TOKEN_BALANCE=1

# ── Treasury economics ──
MIN_CROSS_CHAIN_TRANSFER_USD=20
MIN_DISTRIBUTION_POOL_USD=20
MIN_CLAIM_PAYOUT_USD=1
NOTIFY_MIN_DEPOSIT_USD=2

# ── Trading risk (intentionally aggressive; up to 100% of unreserved BAGFLIP capital) ──
MAX_TREASURY_TRADE_ALLOCATION_PERCENT=100
MAX_POSITION_HOLD_HOURS=24
MAX_CONCURRENT_POSITIONS=4
POSITION_SIZE_PERCENT=25
MIN_POSITION_SOL=0.05
# 0 = no cap
MAX_POSITION_SOL=0
# Strategy variant for the engine: aggressive (default; entry score 0.52, single-scan entries on strong
# signals and fresh graduations) or original (selective; 0.65, two-scan confirmation). See docs/STRATEGY.md.
STRATEGY_VARIANT=aggressive
# Optional override of the variant's entry score (empty = variant default).
ENTRY_SCORE_THRESHOLD=
# Shadow paper books: compare variants side by side on the same live scans (virtual capital, no orders).
SHADOW_VARIANTS=original,aggressive
SHADOW_START_SOL=1
# Free GeckoTerminal discovery (5m trending pools, newest PumpSwap pools, busiest Pump.fun curves).
GECKO_DISCOVERY=true
STOP_LOSS_PERCENT=30
TAKE_PROFIT_PERCENT=80
TAKE_PROFIT_SELL_PERCENT=50
TRAILING_ACTIVATE_PERCENT=40
TRAILING_STOP_PERCENT=25
STALE_EXIT_HOURS=3
MAX_ROUNDTRIP_COST_PERCENT=12
MAX_PRICE_IMPACT_PERCENT=4
MAX_FIXED_COST_PERCENT=3
TRADE_SLIPPAGE_BPS=1500
EXIT_SLIPPAGE_BPS=2500
EMERGENCY_EXIT_SLIPPAGE_BPS=5000
PRIORITY_FEE_LAMPORTS=100000
WINDDOWN_MAX_HOURS=6
REENTRY_COOLDOWN_HOURS=6
SCAN_INTERVAL_SECONDS=30
POSITION_CHECK_INTERVAL_SECONDS=15
RECONCILE_INTERVAL_SECONDS=120
RPC_FAILURE_PAUSE_THRESHOLD=5

# ── Paper trading fill model ──
PAPER_EXTRA_SLIPPAGE_BPS=150
PAPER_TX_FAILURE_RATE=0.05
PAPER_SEED=42

# ── Kill switches (all OFF by default) ──
LIVE_TRADING_ENABLED=false
LIVE_TRANSFERS_ENABLED=false
EMERGENCY_PAUSE=false
